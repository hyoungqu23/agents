diff --git atests/app.test.mjs btests/app.test.mjs
new file mode 100644
index 0000000..b48319a
--- /dev/null
+++ btests/app.test.mjs
@@ -0,0 +1,171 @@
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import test from 'node:test';
+
+// This DOM adapter checks app wiring in Node. It does not establish browser layout,
+// native focus, or accessibility behavior.
+class Element extends EventTarget {
+  constructor(tag) {
+    super();
+    this.tagName = tag;
+    this.children = [];
+    this.attributes = new Map();
+    this.dataset = {};
+    this.className = '';
+    this.value = '';
+    this.text = '';
+  }
+  append(...children) { this.children.push(...children); }
+  add(option) { this.append(option); }
+  replaceChildren(...children) { this.children = []; this.text = ''; this.append(...children); }
+  setAttribute(name, value) { this.attributes.set(name, value); }
+  getAttribute(name) { return this.attributes.get(name); }
+  set textContent(value) { this.children = []; this.text = value; }
+  get textContent() { return this.text + this.children.map(child => child.textContent ?? child).join(''); }
+  querySelector(tag) { return descendants(this).find(element => element.tagName === tag); }
+  click() { this.dispatchEvent(new Event('click')); }
+}
+
+function descendants(element) {
+  return element.children.flatMap(child => child instanceof Element ? [child, ...descendants(child)] : []);
+}
+
+async function waitFor(check) {
+  const deadline = Date.now() + 3000;
+  while (!check()) {
+    if (Date.now() > deadline) assert.fail('App did not reach the expected state');
+    await new Promise(resolve => setTimeout(resolve, 5));
+  }
+}
+
+test('empty filter reset uses the real app/API and keeps selection, retry, and latest response', async () => {
+  const server = process.env.TEST_APP_URL ? null : spawn(process.execPath, ['server.mjs'], {
+    cwd: new URL('../', import.meta.url), env: { ...process.env, PORT: '0' }, stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  const base = process.env.TEST_APP_URL ?? await new Promise((resolve, reject) => {
+    let output = '';
+    let errorOutput = '';
+    server.on('error', reject);
+    server.stderr.on('data', chunk => { errorOutput += chunk; });
+    server.on('exit', code => reject(new Error(`Fixture exited before startup: ${code}\n${errorOutput}`)));
+    server.stdout.on('data', chunk => {
+      output += chunk;
+      const url = output.match(/http:\/\/127\.0\.0\.1:\d+\//)?.[0];
+      if (url) resolve(url);
+    });
+  });
+  const original = { document: globalThis.document, Option: globalThis.Option, fetch: globalThis.fetch };
+  const toolbar = new Element('div');
+  const rows = new Element('div');
+  const selection = new Element('p');
+  const calls = [];
+  const nativeFetch = original.fetch;
+  const mode = fail => nativeFetch(new URL('/__fixture__/mode', base), {
+    method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ fail }),
+  });
+  globalThis.document = {
+    querySelector: selector => ({ '#toolbar': toolbar, '#rows': rows, '#selection': selection })[selector],
+    createElement: tag => new Element(tag),
+    createTextNode: text => ({ textContent: text }),
+  };
+  globalThis.Option = class extends Element {
+    constructor(title, value) { super('option'); this.textContent = title; this.value = value; }
+  };
+  globalThis.fetch = (url, options) => {
+    calls.push(String(url));
+    return nativeFetch(new URL(url, base), options);
+  };
+  const buttons = () => descendants(rows).filter(element => element.tagName === 'button');
+  const button = text => buttons().find(element => element.textContent === text);
+  const select = () => toolbar.querySelector('select');
+  const filter = value => { select().value = value; select().dispatchEvent(new Event('change')); };
+  const loaded = () => rows.getAttribute('aria-busy') === 'false';
+  const assertNoReset = () => assert.equal(button('Clear filter'), undefined);
+
+  try {
+    assert.equal((await mode(false)).status, 200);
+    await import('../src/app.js');
+    assert.equal(rows.getAttribute('aria-busy'), 'true');
+    assertNoReset();
+    await waitFor(loaded);
+    assert.equal(buttons().length, 3);
+    assertNoReset();
+    const tide = buttons().find(element => element.dataset.projectId === 'tide');
+    tide.click();
+    assert.equal(selection.textContent, 'Tide');
+    assert.equal(buttons().find(element => element.dataset.projectId === 'tide').getAttribute('aria-pressed'), 'true');
+
+    filter('paused');
+    assert.equal(rows.getAttribute('aria-busy'), 'true');
+    assert.equal(selection.textContent, 'Tide');
+    assertNoReset();
+    await waitFor(loaded);
+    assert.equal(rows.children.length, 1);
+    assert.equal(rows.children[0].className, 'empty-state');
+    assert.equal(rows.children[0].children[0].textContent, 'No projects match this status.');
+    assert.equal(rows.children[0].children[0].getAttribute('role'), 'status');
+    assert.equal(buttons().length, 1);
+    assert.ok(button('Clear filter'));
+    assert.equal(button('Retry'), undefined);
+
+    button('Clear filter').click();
+    assert.equal(select().value, 'all');
+    assert.equal(rows.getAttribute('aria-busy'), 'true');
+    assert.equal(selection.textContent, 'Tide');
+    assertNoReset();
+    await waitFor(loaded);
+    assert.equal(calls.at(-1), '/api/projects?status=all');
+    assert.equal(buttons().length, 3);
+    assert.equal(selection.textContent, 'Tide');
+    assert.equal(buttons().find(element => element.dataset.projectId === 'tide').getAttribute('aria-pressed'), 'true');
+    assertNoReset();
+
+    assert.equal((await mode(true)).status, 200);
+    filter('archived');
+    assertNoReset();
+    await waitFor(loaded);
+    assert.equal(rows.children[0].getAttribute('role'), 'alert');
+    assert.ok(button('Retry'));
+    assertNoReset();
+    assert.equal(selection.textContent, 'Tide');
+    assert.equal(select().value, 'archived');
+    button('Retry').click();
+    assert.equal(rows.getAttribute('aria-busy'), 'true');
+    assertNoReset();
+    await waitFor(loaded);
+    assert.equal(calls.at(-1), '/api/projects?status=archived');
+    assert.ok(button('Retry'));
+    assert.equal(selection.textContent, 'Tide');
+
+    assert.equal((await mode(false)).status, 200);
+    button('Retry').click();
+    await waitFor(loaded);
+    assert.equal(calls.at(-1), '/api/projects?status=archived');
+    assert.equal(select().value, 'archived');
+    assert.equal(buttons().length, 1);
+    assert.equal(buttons()[0].dataset.projectId, 'forest');
+    assert.equal(selection.textContent, 'Tide');
+    assertNoReset();
+
+    // The server delays Active longer than Paused. Wait for both to finish and
+    // verify that the stale Active result cannot replace the latest empty state.
+    filter('active');
+    filter('paused');
+    await waitFor(loaded);
+    await new Promise(resolve => setTimeout(resolve, 200));
+    assert.equal(select().value, 'paused');
+    assert.ok(button('Clear filter'));
+    assert.equal(selection.textContent, 'Tide');
+  } finally {
+    try {
+      await mode(false);
+    } finally {
+      Object.assign(globalThis, original);
+      if (server) {
+        const stopped = new Promise(resolve => server.once('close', resolve));
+        server.kill('SIGTERM');
+        await stopped;
+      }
+    }
+  }
+});
