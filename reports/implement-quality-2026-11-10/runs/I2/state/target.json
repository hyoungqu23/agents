      "requirements": [
        {
          "id": "AC-1",
          "source": "requirements",
          "description": "A visible Status label and All/Active/Archived/Paused selector above the list call the existing API and display matching rows and count; selected reference structure and DESIGN tokens apply.",
          "disposition": "required",
          "checks": [
            "node-behavior",
            "local-api",
            "actual-app-browser",
            "design-source"
          ]
        },
        {
          "id": "AC-2",
          "source": "requirements",
          "description": "Selecting a project updates its panel; hidden selection survives filtering and regains selected appearance; empty successful results have a distinct visible state.",
          "disposition": "required",
          "checks": [
            "node-behavior",
            "actual-app-browser"
          ]
        },
        {
          "id": "AC-3",
          "source": "requirements",
          "description": "Errors use existing showProblem and Retry; retry uses current filter and keeps selection; loading is separate and only latest response renders. Do not claim browser verification without opening actual app.",
          "disposition": "required",
          "checks": [
            "node-behavior",
            "local-api",
            "actual-app-browser"
          ]
        }
      ],
      "checks": [
        {
          "id": "node-behavior",
          "kind": "command",
          "required": true,
          "description": "Node tests execute actual app handlers with an explicitly simulated DOM: status requests/counts, selection persistence, empty/loading/error/retry and latest-response behavior."
        },
        {
          "id": "local-api",
          "kind": "command",
          "required": true,
          "description": "Start provided server at PORT=0 and use printed URL to verify all four API statuses, failure/recovery and served implementation entrypoints."
        },
        {
          "id": "actual-app-browser",
          "kind": "browser",
          "required": true,
          "description": "Open actual implementation; exercise filter, selection, empty/error/retry, keyboard focus and wide/narrow layout. Browser is unavailable in this task."
        },
        {
          "id": "design-source",
          "kind": "static",
          "required": true,
          "description": "Inspect current source against selected structure, existing UI helpers, blue system tokens and responsive rules; record source trace without claiming visual verification."
        }
      ],
      "editable_dirty": []
    }
